#, c-format
msgid "KHangMan %1"
msgstr "কে-হ্যাংম্যান %1"

#: khangmanview.cpp:69
msgid ""
"The backgrounds files are not found.\n"
"Check your installation, please!"
msgstr ""
"পটভূমির ফাইলগুলো পাওয়া যায় নি।\n"
"অনুগ্রহপূর্বক ইনস্টলকৃত ফাইলগুলো পরীক্ষা করুন!"

#: khangmanview.cpp:179
msgid "Congratulations! You won! Do you want to play again?"
msgstr "অভিনন্দন! আপনি বিজয়ী হয়েছেন! আপনি কি আবারো খেলতে আগ্রহী?"

#: khangmanview.cpp:219
msgid "You lost. Do you want to play again?"
msgstr "হেরে গিয়েছেন।  আপনি কি আবারো খেলতে আগ্রহী?"

#: khangmanview.cpp:221
msgid "You are dead. Do you want to play again?"
msgstr "মরে গিয়েছেন।  আপনি কি আবারো খেলতে আগ্রহী?"

#: khangmanview.cpp:237 khangmanview.cpp:256
msgid "This letter has already been guessed."
msgstr "এই অক্ষরটি ইতিমধ্যেই অনুমান করা হয়েছে।"

#: khangmanview.cpp:368
msgid ""
"File $KDEDIR/share/apps/khangman/data/%1/%2 not found!\n"
"Check your installation, please!"
msgstr ""
"$KDEDIR/share/apps/khangman/data/%1/%2 নামক ফাইলটি পাওয়া যায় নি!\n"
"অনুগ্রহপূর্বক ইনস্টলকৃত ফাইলগুলো পরীক্ষা করুন!"

