# FIXME
#: kalzium_i18n.cpp:337
#, no-c-format
msgid "Isotopes are atoms that contain different numbers of Neutrons."
msgstr "আইসোটোপ হল একই মৌলের সেই সকল পরমাণু যাদের নিউট্রন সংখ্যা ভিন্ন।"

#: kalzium_i18n.cpp:338
#, no-c-format
msgid "Isotopes are atoms that contain different numbers of Protons"
