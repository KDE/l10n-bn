#: parser.cpp:750
msgid ""
"Parser error at position %1:\n"
"Syntax error"
msgstr ""
"%1 অবস্থানে পার্সার ত্রুটি:\n"
"সিনটেক্স ত্রুটি"

#: parser.cpp:754
msgid ""
"Parser error at position %1:\n"
"Missing parenthesis"
msgstr ""
"%1 অবস্থানে পার্সার ত্রুটি:\n"
"বন্ধনী (Parenthesis) পাওয়া যাচ্ছে না"

#: parser.cpp:758
msgid ""
"Parser error at position %1:\n"
"Function name unknown"
msgstr ""
"%1 অবস্থানে পার্সার ত্রুটি:\n"
"অজ্ঞাত ফাংশন"

#: parser.cpp:762
msgid ""
"Parser error at position %1:\n"
"Void function variable"
msgstr ""
"%1 অবস্থানে পার্সার ত্রুটি:\n"
"ফাঁকা ফাংশন চলক"

#: parser.cpp:766
msgid ""
"Parser error at position %1:\n"
"Too many functions"
msgstr ""
"%1 অবস্থানে পার্সার ত্রুটি:\n"
"অত্যধিক সংখ্যক ফাংশন"

#: parser.cpp:770
msgid ""
"Parser error at position %1:\n"
"Token-memory overflow"
msgstr ""
"%1 অবস্থানে পার্সার ত্রুটি:\n"
"টোকেন-মেমরিতে স্থান সংকুলান "
"হচ্ছে না (Overflow)"

#: parser.cpp:774
msgid ""
"Parser error at position %1:\n"
"Stack overflow"
msgstr ""
"%1 অবস্থানে পার্সার ত্রুটি:\n"
"স্ট্যাক-এ স্থান সংকুলান "
"হচ্ছে না (Overflow)"

#: parser.cpp:778
msgid ""
"Parser error at position %1:\n"
"Name of function not free"
msgstr ""
"%1 অবস্থানে পার্সার ত্রুটি:\n"
"ফাংশনের নাম ইতিমধ্যেই "
"ব্যবহৃত হচ্ছে"

#: parser.cpp:782
msgid ""
"Parser error at position %1:\n"
"recursive function not allowed"
msgstr ""
"%1 অবস্থানে পার্সার ত্রুটি:\n"
"Recursive ফাংশনের ব্যবহার "
"অনুমোদিত নয়"

#: parser.cpp:785
#, c-format
msgid "Could not find a defined constant at position %1"
msgstr ""
"%1 অবস্থানে নির্দিষ্টকৃত (Defined) "
"ধ্রুবক পাওয়া যায় নি"

#: parser.cpp:788
msgid "Empty function"
msgstr "ফাঁকা ফাংশন"

#: parser.cpp:790
msgid "The function name is not allowed to contain capital letters"
msgstr ""
"ফাংশনের নামে বড় হাতের অক্ষর "
"থাকতে পারবে না"

#: keditconstant.cpp:61
msgid "Please insert a valid constant name between A and Z."
msgstr ""
"অনুগ্রহপূর্বক A থেকে Z এর "
"মধ্যবর্তী যে কোন অক্ষরকে "
"ধ্রবুকের নাম হিসাবে ঢুকিয়ে "
"দিন।"

#: keditconstant.cpp:78
msgid "The constant already exists."
msgstr ""
"ধ্রুবকটি ইতিমধ্যেই "
"বিদ্যমান।"

