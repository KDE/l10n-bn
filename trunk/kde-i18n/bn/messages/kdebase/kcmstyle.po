#: kcmstyle.cpp:518
msgid ""
"<qt>Selected style: <b>%1</b>"
"<br>"
"<br>One or more effects that you have chosen could not be applied because "
"the selected style does not support them; they have therefore been "
"disabled.<br><br>"
msgstr ""
"<qt>নির্বাচিত স্টাইল: <b>%1</b>"
"<br> "
"<br>আপনার পছন্দ করা এক বা "
"একাধিক এফেক্ট প্রয়োগ করা "
"যায়নি কারণ নির্বাচিত "
"স্টাইলটি এই এফেক্টগুলি "
"সমর্থন করে না; এগুলি "
"নিষ্ক্রিয় করে রাখা হয়েছে।<br><br>"

#: kcmstyle.cpp:530
msgid "Menu translucency is not available.<br>"
