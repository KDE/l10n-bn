#: chooser.cpp:31
msgid "Login chooser for Xdmcp"
msgstr "Xdmcp-র জন্য লগ-ইন বাছাইকারক"

#: chooser.cpp:62
msgid "Specify the chooser socket (in hex)"
msgstr "বাছাইকারক সকেট নির্দিষ্ট করুন (হেক্সাডেসিমাল হিসাবে)"

#: chooser.cpp:63
msgid "Specify the client ip (in hex)"
msgstr "ক্লায়েন্ট আই-পি নির্দিষ্ট করুন (হেক্সাডেসিমাল হিসাবে)"

#: chooser.cpp:64
msgid "Specify the connection type (in dec)"
msgstr "সংযোগ ধরন নির্দিষ্ট করুন (ডেসিমাল হিসাবে)"

#: chooser.cpp:65
msgid "Specify the hosts to list or use BROADCAST"
msgstr "কোন কোন হোস্ট তালিকাভুক্ত করা হবে নির্দিষ্ট করুন অথবা BROADCAST ব্যবহার করুন"

#: DXdmcp.cpp:36
