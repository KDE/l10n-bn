msgid ""
"<qt>\n"
"<p>Select the language of the document you are proofing here.</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>আপনি যে নথীটি নিয়ে কাজ "
"করছেন, সেটির ভাষা বেছে নিন।</p>\n"
"</qt>"

#: rc.cpp:48
