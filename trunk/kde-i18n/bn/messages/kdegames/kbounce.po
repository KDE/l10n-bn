#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "দীপায়ন সরকার"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "deepayan@bengalinux.org"

#: kbounce.cpp:63
msgid "Level:"
msgstr "স্তর:"

#: kbounce.cpp:68
msgid "Score:"
msgstr "স্কোর:"

#: kbounce.cpp:75
msgid "Filled area:"
msgstr "ভর্তি হয়েছে:"

#: kbounce.cpp:80
msgid "Lives:"
msgstr "জীবন:"

#: kbounce.cpp:85
msgid "Time:"
msgstr "সময়:"

#: kbounce.cpp:102
msgid "Press %1 to start a game!"
msgstr "দান শুরু করতে %1 চাপুন!"

#: kbounce.cpp:133
msgid "&Select Image Folder..."
msgstr "ছবির ফোল্ডার বেছে নি&ন..."

#: kbounce.cpp:136
msgid "Show &Images"
msgstr "&ছবি দেখাও"

#: kbounce.cpp:142
msgid "&Play Sounds"
msgstr "আওয়া&জ চালাও"

#: kbounce.cpp:184
msgid "Do you really want to close the running game?"
msgstr ""
"আপনি কি সত্যিই চলন্ত দানটি "
"বন্ধ করতে চান?"

#: kbounce.cpp:204
msgid "Game paused."
msgstr "খেলায় সাময়িক বিরতি।"

#: kbounce.cpp:235
#, c-format
msgid "Game Over! Score: %1"
msgstr "খেল খতম! স্কোর: %1"

#: kbounce.cpp:236
msgid "Game over. Press <Space> for a new game"
msgstr "খেল খতম। নতুন দানের জন্য <Space> চাপুন"

#: kbounce.cpp:256
msgid "Select Background Image Folder"
msgstr "পটভূমি-চিত্রের ফোল্ডার বেছে নিন "

#: kbounce.cpp:276
msgid "You may now turn on background images."
msgstr "এবার আপনি পটভূমি-চিত্র সক্রিয় করতে পারেন।"

#: kbounce.cpp:332
msgid "Game suspended"
msgstr "খেলা স্থগিত"

#: kbounce.cpp:451
#, c-format
msgid "You have successfully cleared more than 75% of the board.\n"
msgstr ""
"আপনি ক্রীড়াক্ষেত্রের ৭৫ "
"শতাংশের বেশী ফাঁকা করতে "
"সক্ষম হয়েছেন।\n"

#: kbounce.cpp:452
msgid "%1 points: 15 points per remaining life\n"
msgstr ""
"%1 পয়েন্ট: বাকি জীবন প্রতি ১৫ "
"পয়েন্ট\n"

#: kbounce.cpp:453
msgid "%1 points: Bonus\n"
msgstr "%1 পয়েন্ট: বোনাস\n"

#: kbounce.cpp:454
msgid "%1 points: Total score for this level\n"
msgstr ""
"%1 পয়েন্ট: এই স্তরের জন্য মোট "
"স্কোর\n"

#: kbounce.cpp:455
msgid "On to level %1. Remember you get %2 lives this time!"
msgstr ""
"এবার আপনি স্তর %1-এ অগ্রসর "
"হলেন। মনে রাখবেন, এখন আপনার "
"%2-টি জীবন!"

#: main.cpp:29
msgid "KDE Bounce Ball Game"
msgstr "কে.ডি.ই বল বাউন্স করার খেলা"

#: main.cpp:34
msgid "KBounce"
msgstr "কে-বাউন্স"

#: main.cpp:38
msgid "Original author"
msgstr "প্রারম্ভিক লেখক"

#: main.cpp:40
msgid "Contributions"
msgstr "সাহায্য"

