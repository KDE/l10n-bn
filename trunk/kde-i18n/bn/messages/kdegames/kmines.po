#: status.cpp:84
msgid ""
"<qt>Time elapsed."
"<br/>It turns <font color=\"blue\">blue</font> if it is a highscore and "
"<font color=\"red\">red</font> if it is the best time.</qt>"
msgstr ""
"<qt>অতিক্রান্ত সময়।"
"<br/> সেরা স্কোর অর্জন করলে এর "
"রং হয় <font color=\"blue\">নীল</font> আর "
"স্বল্পতম সময়ে সমাধান করলে এর "
"রং হয় <font color=\"red\">লাল</font>।</qt>"

