#: kio_ldap.cpp:161
#, c-format
msgid "LDAP server returned the following error: %1"
msgstr ""
"LDAP সার্ভার নিম্নলিখিত ভুল "
"ফেরত পাঠাচ্ছে: %1"

#: kio_ldap.cpp:522
msgid "LDAP Login"
msgstr "LDAP লগ-ইন"

#: kio_ldap.cpp:525
msgid "site:"
msgstr "সাইট:"

#: kio_ldap.cpp:552 kio_ldap.cpp:689
#, fuzzy
msgid "Invalid authorization information."
msgstr "অবৈধ প্রাপ্তাধিকার তথ্য।"

#: kio_ldap.cpp:631
#, c-format
msgid "Cannot set LDAP protocol version %1"
msgstr ""
"LDAP প্রোটোকল সংস্করণ %1 এর মান "
"নির্ধারণ করতে পারছে না"

#: kio_ldap.cpp:649
msgid "Cannot set size limit."
msgstr ""
"আকৃতি সীমা নির্ধারণ করতে "
"পারছে না।"

#: kio_ldap.cpp:659
msgid "Cannot set time limit."
msgstr ""
"সময়সীমা নির্ধারণ করতে পারছে "
"না।"

#: kio_ldap.cpp:668
#, fuzzy
msgid "SASL authentication not compiled into the ldap ioslave."
msgstr ""
"SASL এর পরিচয় প্রমাণ প্রক্রিয়া ldap "
"ioslave এর ভেতর কম্পাইলকৃত নয়।"

#: kio_ldap.cpp:945 kio_ldap.cpp:1026
msgid "The LDIF parser failed."
msgstr "LDIF পার্সার ব্যর্থ।"

#: kio_ldap.cpp:1036
#, c-format
msgid "Invalid LDIF file in line %1."
msgstr "%1 লাইনে অবৈধ LDIF ফাইল।"
