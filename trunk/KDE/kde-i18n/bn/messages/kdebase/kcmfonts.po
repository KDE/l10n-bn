#: fonts.cpp:557
msgid "Used for normal text (e.g. button labels, list items)."
msgstr ""
"সাধারণ লেখার জন্য ব্যবহৃত "
"(যেমন, বাটনের লেবেল, তালিকার "
"আইটেম)।"

#: fonts.cpp:558
msgid "A non-proportional font (i.e. typewriter font)."
msgstr ""
"একটি অ-সমানুপাতিক ফন্ট (যেমন, "
"টাইপরাইটার ফন্ট)।"

#: fonts.cpp:559
msgid "Used to display text beside toolbar icons."
msgstr ""
"টুলবার আইকনগুলোর পাশে লেখা "
"দেখাতে ব্যবহৃত।"

#: fonts.cpp:560
msgid "Used by menu bars and popup menus."
msgstr ""
"মেনু বার এবং পপ্‌-আপ মেনু "
"কর্তৃত ব্যবহৃত।"

#: fonts.cpp:561
msgid "Used by the window titlebar."
msgstr ""
"উইন্ডো শিরোনাম বার কর্তৃক "
"ব্যবহৃত।"

#: fonts.cpp:562
msgid "Used by the taskbar."
msgstr "টাস্কবার কর্তৃক ব্যবহৃত।"

#: fonts.cpp:563
msgid "Used for desktop icons."
msgstr ""
"ডেস্কটপ আইকন কর্তৃক "
"ব্যবহৃত।"

#: fonts.cpp:614
msgid "Ad&just All Fonts..."
msgstr "সকল ফন্ট &পরিবর্তন করো..."

#: fonts.cpp:615
msgid "Click to change all fonts"
msgstr ""
"সকল ফন্ট পরিবর্তন করতে ক্লিক "
"করুন"

#: fonts.cpp:622
msgid "Use a&nti-aliasing for fonts"
msgstr ""
"ফন্টের জন্য "
"অ্যান্টি-&এলিয়াসিং ব্যবহার "
"করুন"

#: fonts.cpp:623
msgid "If this option is selected, KDE will smooth the edges of curves in fonts."
msgstr ""
"যদি এই অপশন নির্বাচিত থাকে, "
"কে-ডি-ই ফন্টগুলোতে কার্ভের "
"এজ্‌ মসৃণ করবে।"

#: fonts.cpp:626
msgid "Configure..."
msgstr "কন্‌ফিগার করো..."

#: fonts.cpp:714
msgid ""
"<p>You have changed anti-aliasing related settings. This change will only "
"affect newly started applications.</p>"
msgstr ""
"<p>আপনি অ্যান্টি-এলিয়াসিং "
"সংক্রান্ত সেটিংস পরিবর্তন "
"করেছেন। এই পরিবর্তন শুধু "
"নতুনভাবে চালু হওয়া "
"অ্যাপ্লিকেশনসমূহকে "
"প্রভাবিত করবে।</p>"

#: fonts.cpp:715
msgid "Anti-Aliasing Settings Changed"
msgstr ""
"অ্যান্টি-এলিয়াসিং সেটিংস "
"পরিবর্তিত হয়েছে"

