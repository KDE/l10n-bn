#: dict.cpp:1477
msgid "The server is temporarily unavailable."
msgstr "সার্ভার সাময়িকভাবে পাওয়া যাচ্ছে না।"

#: dict.cpp:1480
#, fuzzy
msgid ""
"The server reported a syntax error.\n"
"This should not happen -- please consider\n"
"writing a bug report."
msgstr ""
"সার্ভার একটি বাক্যরীতি ত্রুটি প্রতিবেদন করল।\n"
"এটি ঘটা উচিত নয় -- অনুগ্রহ করে\n"
"একটি প্রোগ্রাম ত্রুটি প্রতিবেদন লিখে পাঠান।"

#: dict.cpp:1483
#, fuzzy
msgid ""
"A command that Kdict needs is not\n"
"implemented on the server."
msgstr ""
"একটি কম্যান্ড যেটি কে-ডিক্ট-এর প্রয়োজন সার্ভারে সেটির\n"
"বাস্তবায়ন করা হয়নি।"

#: dict.cpp:1486
msgid ""
"Access denied.\n"
"This host is not allowed to connect."
msgstr ""
"উপলব্ধি অস্বীকার করল।\n"
"এই হোস্টটিতে সংযোগ করার অনুমতি নেই।"

#: dict.cpp:1489
msgid ""
"Authentication failed.\n"
"Please enter a valid username and password."
msgstr ""
"পরিচয় প্রমাণ প্রক্রিয়া ব্যর্থ হল।\n"
"অনুগ্রহ করে একটি বৈধ ব্যবহারকারীর নাম এবং পাসওয়ার্ড ঢোকান।"

#: dict.cpp:1492
msgid ""
"Invalid database/strategy.\n"
"You probably need to use Server->Get Capabilities."
msgstr ""
"অবৈধ ডেটাবেস/কৌশল।\n"
"আপনার সম্ভবত Server->Get সক্ষমতা ব্যবহার করার প্রয়োজন।"

#: dict.cpp:1495
msgid ""
"No databases available.\n"
"It is possible that you need to authenticate\n"
"with a valid username/password combination to\n"
"gain access to any databases."
msgstr ""
"কোনও ডেটাবেস পাওয়া যাচ্ছে না।\n"
"সম্ভবত আপনার নির্বাচিত সবকটি ডেটাবেস\n"
"ব্যবহার করতে একটি বৈধ ব্যবহারকারীর নাম/পাসওয়ার্ড দিয়ে\n"
"পরিচয় প্রমাণ করা প্রয়োজন।"

#: dict.cpp:1498
msgid "No strategies available."
msgstr "কোনও কৌশল পাওয়া যাচ্ছে না।"

#: dict.cpp:1501
#, fuzzy, qt-format
msgid ""
"The server sent an unexpected reply:\n"
