#: rc.cpp:1008 rc.cpp:1168 rc.cpp:1171
msgid "Neutron"
msgstr "নিউট্রন"

#. i18n: tag name
#. i18n: file data/knowledge.xml line 124
#: rc.cpp:1011
msgid "Atomic nucleus"
msgstr "পারমাণবিক নিউক্লিয়াস"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 125
#: rc.cpp:1014
msgid ""
"The small, positively-charged center of an Atom, in which Protons and "
"Neutrons are found."
msgstr "পরমাণুর ছোট কিন্তু ধনাত্মক চার্জযুক্ত কেন্দ্র, যেখানে প্রোটোন ও নিউট্রন থাকে।"

#. i18n: tag name
#. i18n: file data/knowledge.xml line 131
#: rc.cpp:1020 src/kalziumgradienttype.cpp:244
msgid "Atomic Mass"
msgstr "পারমাণবিক ভর"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 132
#: rc.cpp:1023
msgid ""
"Mass of an atom, taken on a scale where the the mass of a carbon atom is "
"12u. In elements that consist of different isotopes the mid-range mass of "
"the isotope mix is given."
msgstr ""

