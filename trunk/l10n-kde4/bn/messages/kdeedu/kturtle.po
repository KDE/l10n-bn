#: interpreter/executer.cpp:272
#, kde-format
msgid "Internationalized string with an %1"
msgstr "%1 যুক্ত আন্তর্জাতিক পংক্তি"

#: interpreter/executer.cpp:273
#, kde-format
msgid "The %1 command accepts no parameters."
msgstr "কমান্ড %1 কোন মান গ্রহণ করে না।"

#: interpreter/executer.cpp:283
#, kde-format
msgid "The %2 command was called with %3 but needs 1 parameter."
msgid_plural "The %2 command was called with %3 but needs %1 parameters."
msgstr[0] "%2 কমান্ডকে %3-টি মান দেওয়া হয়েছে যেখানে প্রয়োজন হল %1 টি"
msgstr[1] "%2 কমান্ডকে %3-টি মান দেওয়া হয়েছে যেখানে প্রয়োজন হল %1 গুলো ।"

#: interpreter/executer.cpp:285
#, kde-format
msgid "The %2 command was called with %3 but only accepts 1 parameter."
msgid_plural "The %2 command was called with %3 but only accepts %1 parameters."
msgstr[0] "%2 কমান্ডকে %3 টি মান দেওয়া হয়েছে যেখানে এটি মাত্র %1 গুলো মান গ্রহণ করে।"
msgstr[1] "%2 কমান্ডকে %3-টি মান দেওয়া হয়েছে যেখানে এটি মাত্র %1 টি মান গ্রহণ করে।"

#: interpreter/executer.cpp:303
#, kde-format
msgid "The %1 command only accepts a string as its parameter."
msgstr "কমান্ড %1 তার মান হিসেবে শুধুমাত্র একটি পংক্তিকে গ্রহণ করে।"

#: interpreter/executer.cpp:305
#, kde-format
msgid "The %1 command only accepts strings as its parameters."
msgstr "কমান্ড %1 তার মান হিসেবে শুধু পংক্তি গ্রহণ করে।"

#: interpreter/executer.cpp:310
#, kde-format
msgid "The %1 command only accepts a number as its parameter."
msgstr "কমান্ড %1 তার মান হিসেবে শুধুমাত্র একটি সংখ্যাকে গ্রহণ করে।"

#: interpreter/executer.cpp:312
#, kde-format
msgid "The %1 command only accepts numbers as its parameters."
msgstr "কমান্ড %1 তার মান হিসেবে শুধু সংখ্যা গ্রহণ করে।"

#: interpreter/executer.cpp:317
#, kde-format
msgid "The %1 command only accepts an answer as its parameter."
msgstr "কমান্ড %1 তার মান হিসেবে শুধুমাত্র একটি উত্তর গ্রহণ করে।"

#: interpreter/executer.cpp:319
#, kde-format
msgid "The %1 command only accepts answers as its parameters."
