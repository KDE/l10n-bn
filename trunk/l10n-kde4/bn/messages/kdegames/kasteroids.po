#: main.cpp:21
msgid "KDE Space Game"
msgstr "কেডিই-র পক্ষ থেকে একটি মহাশূন্যের খেলা"

#: main.cpp:25
msgid "KAsteroids"
msgstr "কে-অ্যাস্টেরয়েড্‌স"

#: rc.cpp:3 rc.cpp:6
msgid "Whether power upgrades can be shot."
msgstr "পাওয়ার আপগ্রেড ছোঁড়া যাবে কিনা।"

#: rc.cpp:9
msgid "The number of ships per game."
msgstr "খেলা প্রতি জাহাজের সংখ্যা।"

#: rc.cpp:12
msgid "Whether to play sounds."
msgstr "শব্দ বাজানো হবে কিনা।"

#: rc.cpp:15
msgid "Sound to play when a ship gets destroyed."
msgstr "জাহাজ ধ্বংস হয়ে যাওয়ার সময় যে শব্দ বাজানো হবে।"

#: rc.cpp:18
msgid "Sound to play when a rock gets destroyed."
msgstr "পাথর ধ্বংস হয়ে যাওয়ার সময় যে শব্দ বাজানো হবে।"

#: rc.cpp:19
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "প্রজ্ঞা"

#: rc.cpp:20
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "progga@BengaLinux.Org"

#: toplevel.cpp:109
msgid "Score"
msgstr "স্কোর"

#: toplevel.cpp:123
msgid "Level"
msgstr "স্তর"

#: toplevel.cpp:137
msgid "Ships"
msgstr "জাহাজ"

#: toplevel.cpp:239
msgid "Fuel"
msgstr "জ্বালানি"

#: toplevel.cpp:301
msgid "Thrust"
msgstr "সম্মুখ গতি"

#: toplevel.cpp:305
msgid "Rotate Left"
msgstr "বামে ঘোরো"

#: toplevel.cpp:309
msgid "Rotate Right"
msgstr "ডানে ঘোরো"

#: toplevel.cpp:313
msgid "Shoot"
msgstr "গোলা ছোড়ো"

#: toplevel.cpp:317
msgid "Brake"
msgstr "ব্রেক"

#: toplevel.cpp:321
msgid "Shield"
msgstr "ঢাল"

#: toplevel.cpp:340
msgid "Launch"
msgstr "চালু করো"

#: toplevel.cpp:512 toplevel.cpp:606
#, qt-format
msgid "Press %1 to launch."
msgstr "চালু করার জন্য %1 চাপুন।"

#: toplevel.cpp:537
#, qt-format
msgid "Ship Destroyed. Press %1 to launch."
msgstr "জাহাজ ধ্বংসপ্রাপ্ত হয়েছে।  আবারো চালু করার জন্য %1 চাপুন।"

#: toplevel.cpp:543
msgid "Game Over!"
msgstr "খেল খতম!"

#: toplevel.cpp:627
msgid "Start new game with"
msgstr "এটির সাহায্যে নতুন খেলা আরম্ভ করুন"

#: toplevel.cpp:632
msgid " ships."
msgstr " জাহাজ।"

#: toplevel.cpp:639
msgid "Show highscores on Game Over"
msgstr "খেলা শেষ হয়ে যাওয়ার পর সেরা স্কোরগুলো দেখাও"

#: toplevel.cpp:641
msgid "Player can destroy Powerups"
msgstr "খেলোয়াড় পাওয়ার-আপ ধ্বংস করতে পারে"

#: toplevel.cpp:650
msgid "General"
msgstr "সাধারণ"

#: toplevel.cpp:670
#, qt-format
msgid ""
"Game Over\n"
"\n"
"Shots fired:\t%1\n"
"  Hit:\t%2\n"
"  Missed:\t%3\n"
"Hit ratio:\t%4 %\t\t"
msgstr ""
"খেল খতম\n"
"\n"
"নিক্ষিপ্ত গোলা:\t%1\n"
"  আঘাত:\t%2\n"
"  লক্ষ্যভ্রষ্ট:\t%3\n"
"আঘাত অনুপাত:\t%4 %\t\t"

#: toplevel.cpp:694
msgid "KAsteroids is paused."
msgstr "কে-অ্যাস্টেরয়েড্‌স স্থগিতাবস্থায় আছে।"

#: toplevel.cpp:695
msgid "Paused"
msgstr "স্থগিত"
