#: kwriteconfig.cpp:21
msgid "Use <file> instead of global config"
msgstr "গ্লোবাল কনফিগ-এর পরিবর্তে <file> ব্যবহার করো"

#: kwriteconfig.cpp:22
msgid "Group to look in"
msgstr "যে গ্রুপ-এ খোঁজা হবে"

#: kwriteconfig.cpp:23
msgid "Key to look for"
msgstr "যে কী (Key) খোঁজা হবে "

#: kwriteconfig.cpp:24
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr ""
"ভেরিয়েবল-এর টাইপ। বুলিয়ান-এর জন্য \"bool\" ব্যবহার করুন, বাকি সব string হিসাবে "
"গণ্য হবে"

#: kwriteconfig.cpp:25
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr ""

#: kwriteconfig.cpp:30
msgid "KWriteConfig"
msgstr "কে-রাইট-কনফিগ"

#: kwriteconfig.cpp:32
msgid "Write KConfig entries - for use in shell scripts"
msgstr "কনফিগ এন্ট্রি লেখে - শেল স্ক্রিপ্ট-এ ব্যবহারের জন্য"

