#: appearance.cpp:38
msgid ""
"<h1>Konqueror Fonts</h1>On this page, you can configure which fonts "
"Konqueror should use to display the web pages you view."
msgstr ""
"<h1>কনকরার ফন্ট</h1>এখানে আপনি নির্ধারণকরতে পারেন কনকরার ওয়েব পেজ দেখাতে কোন "
"ফন্ট ব্যবহার করবে"

#: appearance.cpp:52
msgid "Font Si&ze"
msgstr "ফন্ট মা&প"

#: appearance.cpp:56 appearance.cpp:74
msgid "This is the relative font size Konqueror uses to display web sites."
msgstr "ওয়েবসাইট দেখাতে কনকরার দ্বারা ব্যবহৃত ফন্টগুলির তুলনামূলক মাপ"

#: appearance.cpp:59
msgid "M&inimum font size:"
msgstr "ন্যু&নতম ফন্ট মাপ:"

#: appearance.cpp:64
msgid ""
"Konqueror will never display text smaller than this size,<br>overriding any "
"other settings"
msgstr ""
"কনকরার কখনই এর চেয়ে ছোট লেখা দেখাবে না,<br> অন্যান্য সেটিংস যাই হোক না কেন"

#: appearance.cpp:69
msgid "&Medium font size:"
msgstr "মাঝারি ফন্ট মা&প:"

#: appearance.cpp:78
msgid "S&tandard font:"
msgstr "স্ট্যাণ্ডার্ড &ফন্ট:"

#: appearance.cpp:86
msgid "This is the font used to display normal text in a web page."
msgstr "ওয়েব পেজ-এ সাধারণ লেখা দেখাতে এই ফন্ট ব্যবহার করা হবে"

#: appearance.cpp:93
msgid "&Fixed font:"
msgstr "ফিক্সড ফন্ট (&ড):"

#: appearance.cpp:101
msgid ""
"This is the font used to display fixed-width (i.e. non-proportional) text."
msgstr "ফিক্সড উইডথ (নন-প্রোপর্শনাল) লেখা জন্য ব্যবহৃত ফন্ট"

#: appearance.cpp:108
msgid "S&erif font:"
msgstr "সেরিফ ফন্ট (&স):"

#: appearance.cpp:116
msgid "This is the font used to display text that is marked up as serif."
msgstr "এই ফন্টটি \"সেরিফ\" হিসাবে চিহ্নিত লেখা দেখাতে ব্যবহার করা হবে।"

#: appearance.cpp:123
msgid "Sa&ns serif font:"
msgstr "সান্স সেরিফ ফন্ট (&ট):"

#: appearance.cpp:131
msgid "This is the font used to display text that is marked up as sans-serif."
msgstr "এই ফন্টটি \"সান্স সেরিফ\" হিসাবে চিহ্নিত লেখা দেখাতে ব্যবহার করা হবে।"

#: appearance.cpp:138
msgid "C&ursive font:"
msgstr "কার্সিভ ফন্ট (&ভ):"

#: appearance.cpp:146
msgid "This is the font used to display text that is marked up as italic."
msgstr "এই ফন্টটি \"ইটালিক\" হিসাবে চিহ্নিত লেখা দেখাতে ব্যবহার করা হবে।"

#: appearance.cpp:153
msgid "Fantas&y font:"
msgstr "ফ্যাণ্টাসি ফন্ট (&ণ):"

#: appearance.cpp:161
msgid ""
"This is the font used to display text that is marked up as a fantasy font."
msgstr "এই ফন্টটি \"ফ্যাণ্টাসি\" হিসাবে চিহ্নিত লেখা দেখাতে ব্যবহার করা হবে।"

#: appearance.cpp:173
msgid "Font &size adjustment for this encoding:"
msgstr "এই এনকোডিঙের &জন্য ফন্টের মাপে সংশোধন:"

#: appearance.cpp:187
msgid "Default encoding:"
msgstr "ডিফল্ট এনকোডিং:"

#: appearance.cpp:196 appearance.cpp:367
msgid "Use Language Encoding"
msgstr "ভাষা এনকোডিং ব্যবহার করো"

#: appearance.cpp:200
msgid ""
"Select the default encoding to be used; normally, you will be fine with 'Use "
"language encoding' and should not have to change this."
msgstr ""
"স্পষ্ট কোন এনকোডিং উল্লেখ না করা থাকলে যে এনকোডিং ব্যবহৃত হবে সেটি বেছে নিন। "
"এখানে 'ভাষা এনকোডিং ব্যবহার করো' রেখে দিলে সাধারণত কোন অসুবিধা হবার কথা নয়। "

#: domainlistview.cpp:50
msgid "Host/Domain"
msgstr "হোস্ট/ডোমেইন"

#: domainlistview.cpp:51
msgid "Policy"
msgstr "পলিসি"

#: domainlistview.cpp:58
msgid "&New..."
msgstr "&নতুন..."

#: domainlistview.cpp:62
msgid "Chan&ge..."
msgstr "পরি&বর্তন..."

#: domainlistview.cpp:66
msgid "De&lete"
msgstr "মুছে ফেলো (&ম)"

#: domainlistview.cpp:70
msgid "&Import..."
msgstr "&আমদানি..."

#: domainlistview.cpp:76
msgid "&Export..."
msgstr "&রপ্তানি..."

#: domainlistview.cpp:85
msgid "Click on this button to manually add a host or domain specific policy."
msgstr ""
"বিশেষ একটি হোস্ট অথবা ডোমেইন-এর জন্য নিজে হাতে পলিসি যোগ করতে এই বাটন-এ ক্লিক "
"করুন।"

#: domainlistview.cpp:87
msgid ""
"Click on this button to change the policy for the host or domain selected in "
"the list box."
msgstr ""
"লিস্ট-বক্স-এ নির্বাচিত হোস্ট বা ডোমেইন-এর জন্য পলিসি পরিবর্তন করতে এই বাটন-এ ক্লিক "
"করুন।"

#: domainlistview.cpp:89
msgid ""
"Click on this button to delete the policy for the host or domain selected in "
"the list box."
msgstr ""
"লিস্ট-বক্স-এ নির্বাচিত হোস্ট বা ডোমেইন-এর জন্য পলিসি মুছে ফেলতে এই বাটন-এ ক্লিক "
"করুন। "

#: domainlistview.cpp:136
msgid "You must first select a policy to be changed."
msgstr "পরিবর্তন করার জন্য প্রথমে একটি পলিসি নির্বাচন করতে হবে।"

#: domainlistview.cpp:165
msgid "You must first select a policy to delete."
msgstr "মুছে ফেলার জন্য প্রথমে একটি পলিসি নির্বাচন করতে হবে।"

#: domainlistview.cpp:203 policydlg.cpp:55
msgid "Use Global"
msgstr "গ্লোবাল ব্যবহার করো"

#: domainlistview.cpp:205 policydlg.cpp:55
msgid "Accept"
msgstr "স্বীকার করো"

#: domainlistview.cpp:207 policydlg.cpp:55
msgid "Reject"
msgstr "প্রত্যাখ্যান করো"

#: filteropts.cpp:54
msgid "Enable filters"
msgstr "ফিল্টার সক্রিয় করো"

#: filteropts.cpp:57
msgid "Hide filtered images"
msgstr ""

