#: main.cpp:46
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - দূরবর্তী ফাইল খোলে, পরিবর্তন লক্ষ্য রাখে, আপলোড করা হবে কি না জিজ্ঞাসা "
"করে"

#: main.cpp:50
msgid "Treat URLs as local files and delete them afterwards"
msgstr "ইউ-আর-এল স্থানীয় ফাইল হিসাবে দেখে এবং পরে মুছে ফেলে"

#: main.cpp:51
msgid "Command to execute"
msgstr "যে কমান্ড চালানো হবে"

#: main.cpp:52
msgid "URL(s) or local file(s) used for 'command'"
msgstr "'কমান্ড'-এর জন্য ব্যবহৃত ইউ-আর-এল অথবা স্থানীয় ফাইল"

#: main.cpp:61
msgid "'command' expected.\n"
msgstr "'কমান্ড' প্রত্যাশিত।\n"

