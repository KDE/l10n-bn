#: main.cpp:44
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - দূরবর্তী ফাইল খোলে, পরিবর্তন লক্ষ্য রাখে, আপলোড করা হবে কি না জিজ্ঞাসা "
"করে"

#: main.cpp:52
msgid "'command' expected.\n"
msgstr "'কমান্ড' প্রত্যাশিত।\n"

#: main.cpp:81
#, kde-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"%1 ইউ-আর-এল-টি\n"
"ত্রুটিপূর্ণ"

#: main.cpp:83
#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"দূরবর্তী ইউ-আর-এল %1\n"
"--tempfiles সহ অনুমোদিত নয়"

#: main.cpp:216
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"তথাকথিত অস্থায়ী ফাইল\n"
"%1\n"
"পরিবর্তন করা হয়েছে।\n"
"আপনি কি তা সত্বেও এটি মুছে ফেলতে চান?"

#: main.cpp:217
msgid "Do Not Delete"
msgstr "মুছে ফেলো না"

#: main.cpp:217 main.cpp:224
msgid "File Changed"
msgstr "ফাইল পরিবর্তিত"

#: main.cpp:223
#, kde-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"%1\n"
"ফাইলটি পরিবর্তিত হয়েছে।\n"
"আপনি কি পরিবর্তনগুলি আপলোড করতে চান?"

#: main.cpp:224
msgid "Do Not Upload"
msgstr "আপলোড কোর না"

#: main.cpp:224
msgid "Upload"
msgstr "আপলোড"

